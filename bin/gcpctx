#!/usr/bin/env bash
# gcpctx — manage gcloud ADC + project contexts (folder / CLI / env API)
# Copyright 2026 UriBer. Licensed under Apache-2.0.
set -eo pipefail

# Resolve package/lib root (symlink-aware)
_GCPCTX_ROOT=""
_gcpctx_resolve_root() {
  local src="${BASH_SOURCE[0]:-$0}"
  if command -v realpath >/dev/null 2>&1; then
    src="$(realpath "$src" 2>/dev/null || echo "$src")"
  fi
  _GCPCTX_ROOT="$(cd "$(dirname "$src")/.." && pwd)"
}
_gcpctx_resolve_root

# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/validation.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/exports.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/filesystem.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/version.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/gcloud.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/doctor.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/config.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/history.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/classify.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/bq.sh"
# shellcheck source=/dev/null
source "$_GCPCTX_ROOT/lib/finops.sh"

gcpctx_umask_secure

GCPCTX_HOME="${GCPCTX_HOME:-$HOME/.gcpctx}"
CONTEXTS_DIR="$GCPCTX_HOME/contexts"
ACTIVE_FILE="$GCPCTX_HOME/active"
GCLOUD_ADC="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json"
MARKER_NAME=".gcpctx"

usage() {
  cat <<'EOF'
gcpctx — switch GCP account/project/ADC safely

Usage:
  gcpctx init [--name NAME] [--project PROJECT] [--account ACCOUNT]
              [--region REGION] [--zone ZONE] [--gcloud-config NAME]
  gcpctx login [NAME]
  gcpctx use <name> [--project PROJECT]
  gcpctx project <project-id>              # switch project in active context
  gcpctx project set <project-id>
  gcpctx scan [NAME] [--json]              # discover projects for context account
  gcpctx projects [NAME] [--json] [--refresh]
  gcpctx activate
  gcpctx deactivate
  gcpctx list
  gcpctx current [--json] [--prompt]
  gcpctx env [--export]
  gcpctx exec [--dry-run] [--snapshot] [--undo-cmd CMD] [--] <command>...
  gcpctx history [--json] [--limit N] [--context NAME] [--project ID]
  gcpctx history show <id>
  gcpctx history snapshots [--json] [--project ID]
  gcpctx timeline [--json] [--limit N]
  gcpctx snapshots [--json] [--project ID]
  gcpctx replay <id> [--context NAME] [--project ID] [--dry-run]
  gcpctx undo [<id>] [--dry-run] [--install-finops]
  gcpctx protect <name>
  gcpctx unprotect <name>
  gcpctx assert [--context NAME] [--project ID] [--account EMAIL]
  gcpctx completion bash|zsh|powershell
  gcpctx doctor [--fix] [--json]
  gcpctx secrets fix
  gcpctx bootstrap
  gcpctx sync-adc [NAME]
  gcpctx shell-setup [--zshrc PATH] [--bashrc PATH] [--pwsh-profile PATH]
  gcpctx shell-path [--zsh|--bash|--ps1]
  gcpctx which
  gcpctx version
  gcpctx help

Contexts are account/env units. Scan loads the projects that account can
access; then switch projects inside the context without re-login:

  gcpctx use prod
  gcpctx scan
  gcpctx projects
  gcpctx use prod --project other-gcp-project
  gcpctx project yet-another-project

History (on by default; set history.enabled=false in config.json or
GCPCTX_HISTORY=0 to disable). Commands are journaled with PII (account,
project, argv) — never credential bodies. Undo restores local context and
classified cloud mutations; BQ deletes use snapshot tables + time travel.

  gcpctx history
  gcpctx snapshots
  gcpctx undo
  gcpctx exec --dry-run -- bq query --use_legacy_sql=false 'SELECT 1'
  gcpctx replay <id> --project other-project

Shell activation (required for env in your interactive shell):
  eval "$(gcpctx use dev --export)"
  eval "$(gcpctx activate --export)"
  eval "$(gcpctx deactivate --export)"

Or install the zsh wrapper from shell/gcpctx.zsh so use/activate/deactivate/
project auto-eval without typing eval.

Folder marker:
  ./.gcpctx  →  {"name":"prod","project":"my-gcp-project"}

App / API env vars set on activate:
  GOOGLE_APPLICATION_CREDENTIALS
  GOOGLE_CLOUD_PROJECT
  GOOGLE_CLOUD_QUOTA_PROJECT
  CLOUDSDK_CORE_PROJECT
  CLOUDSDK_ACTIVE_CONFIG_NAME
  GCPCTX_NAME
EOF
}

# Resolve install root (symlink-aware) for package.json / shell hooks
package_root() {
  if [[ -f "$_GCPCTX_ROOT/package.json" || -f "$_GCPCTX_ROOT/shell/gcpctx.zsh" ]]; then
    echo "$_GCPCTX_ROOT"
    return 0
  fi
  if [[ -n "${GCPCTX_PACKAGE_ROOT:-}" && -f "${GCPCTX_PACKAGE_ROOT}/shell/gcpctx.zsh" ]]; then
    echo "$GCPCTX_PACKAGE_ROOT"
    return 0
  fi
  if command -v npm >/dev/null 2>&1; then
    local npm_pkg
    npm_pkg="$(npm root -g 2>/dev/null)/gcpctx"
    if [[ -f "$npm_pkg/shell/gcpctx.zsh" ]]; then
      echo "$npm_pkg"
      return 0
    fi
  fi
  echo "$_GCPCTX_ROOT"
}

read_package_version() {
  gcpctx_read_version "$(package_root)"
}

die() { gcpctx_die "$*"; }
info() { echo "gcpctx: $*" >&2; }

ensure_dirs() {
  gcpctx_ensure_dir_700 "$GCPCTX_HOME"
  gcpctx_ensure_dir_700 "$CONTEXTS_DIR"
  gcpctx_ensure_dir_700 "$GCPCTX_HOME/tmp"
  gcpctx_config_ensure
  if gcpctx_history_enabled; then
    gcpctx_history_ensure
  fi
}

secure_file_600() { gcpctx_chmod_600 "$1"; }
secure_dir_700() { gcpctx_ensure_dir_700 "$1"; }


file_mode_octal() {
  local f="$1"
  if stat -f '%OLp' "$f" >/dev/null 2>&1; then
    stat -f '%OLp' "$f"
  else
    stat -c '%a' "$f"
  fi
}

mode_too_open() {
  # true if group/other have any permission bits
  local mode="$1"
  mode=$((8#$mode))
  [[ $((mode & 077)) -ne 0 ]]
}

adc_meta_get() {
  # adc_meta_get <file> <key> — safe field only; never dump file
  local file="$1" key="$2"
  [[ -f "$file" ]] || { echo ""; return 0; }
  python3 -c '
import json, sys
path, key = sys.argv[1], sys.argv[2]
allowed = {"quota_project_id", "type", "account", "universe_domain", "client_id"}
if key not in allowed:
    print("")
    raise SystemExit(0)
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    print("")
    raise SystemExit(0)
val = data.get(key, "")
if val is None:
    val = ""
# never print secret-looking values
if key in ("refresh_token", "client_secret", "private_key"):
    print("")
else:
    print(val)
' "$file" "$key"
}

json_get() {
  # json_get <file> <key>
  local file="$1" key="$2"
  python3 -c '
import json, sys
path, key = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
val = data.get(key, "")
if val is None:
    val = ""
print(val)
' "$file" "$key"
}

json_write_meta() {
  local path="$1"
  shift
  python3 -c '
import json, sys
path = sys.argv[1]
keys = sys.argv[2::2]
vals = sys.argv[3::2]
data = {}
try:
    with open(path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    data = {}
for k, v in zip(keys, vals):
    data[k] = v
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
' "$path" "$@"
}

context_dir() {
  echo "$CONTEXTS_DIR/$1"
}

context_meta() {
  echo "$(context_dir "$1")/meta.json"
}

context_creds() {
  echo "$(context_dir "$1")/credentials.json"
}

context_projects() {
  echo "$(context_dir "$1")/projects.json"
}

context_exists() {
  [[ -f "$(context_meta "$1")" ]]
}

require_context() {
  gcpctx_validate_context_name "$1"
  context_exists "$1" || die "unknown context '$1' (try: gcpctx list)"
}

read_active_name() {
  if [[ -n "${GCPCTX_NAME:-}" ]]; then
    echo "$GCPCTX_NAME"
    return
  fi
  if [[ -f "$ACTIVE_FILE" ]]; then
    tr -d '[:space:]' < "$ACTIVE_FILE"
  fi
}

find_marker() {
  local dir="$PWD"
  while true; do
    if [[ -f "$dir/$MARKER_NAME" ]]; then
      echo "$dir/$MARKER_NAME"
      return 0
    fi
    if [[ "$dir" == "/" ]]; then
      return 1
    fi
    dir="$(dirname "$dir")"
  done
}

marker_field() {
  # marker_field <name|project>
  local field="$1"
  local marker
  marker="$(find_marker)" || return 1
  python3 -c '
import json, sys
path, field = sys.argv[1], sys.argv[2]
raw = open(path).read().strip()
if not raw:
    sys.exit(1)
if raw.startswith("{"):
    data = json.loads(raw)
    if field == "name":
        val = data.get("name") or data.get("context") or ""
    else:
        val = data.get(field) or ""
else:
    parts = raw.split()
    val = parts[0] if field == "name" and parts else ""
    if field == "project" and len(parts) > 1:
        val = parts[1]
if not val:
    sys.exit(1)
print(val)
' "$marker" "$field"
}

marker_name() {
  marker_field name
}

marker_project() {
  marker_field project 2>/dev/null || true
}

ensure_gcloud_config() {
  local name="$1" account="$2" project="$3" region="$4" zone="$5"
  # Clear ambient project/ADC env so gcloud writes the configuration file cleanly
  if ! env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
      -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
      gcloud config configurations describe "$name" &>/dev/null; then
    gcloud config configurations create "$name" --quiet >/dev/null
  fi
  env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
    -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
    gcloud --configuration="$name" config set account "$account" --quiet >/dev/null
  env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
    -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
    gcloud --configuration="$name" config set project "$project" --quiet >/dev/null
  if [[ -n "$region" ]]; then
    env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
      -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
      gcloud --configuration="$name" config set compute/region "$region" --quiet >/dev/null || true
  fi
  if [[ -n "$zone" ]]; then
    env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
      -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
      gcloud --configuration="$name" config set compute/zone "$zone" --quiet >/dev/null || true
  fi
}

activate_gcloud_config() {
  local name="$1"
  env -u CLOUDSDK_CORE_PROJECT -u GOOGLE_CLOUD_PROJECT -u GCLOUD_PROJECT \
    -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT \
    gcloud config configurations activate "$name" --quiet >/dev/null
}

sync_well_known_adc() {
  local name="$1"
  local creds
  creds="$(context_creds "$name")"
  [[ -f "$creds" ]] || die "no credentials for '$name' (run: gcpctx login $name)"
  secure_file_600 "$creds"
  mkdir -p "$(dirname "$GCLOUD_ADC")"
  cp "$creds" "$GCLOUD_ADC"
  chmod 600 "$GCLOUD_ADC"
}

print_exports() {
  local name="$1"
  local project_override="${2:-}"
  require_context "$name"
  local meta creds project account quota gcloud_config region zone
  meta="$(context_meta "$name")"
  creds="$(context_creds "$name")"
  [[ -f "$creds" ]] || die "no credentials for '$name' (run: gcpctx login $name)"
  project="$(json_get "$meta" project)"
  account="$(json_get "$meta" account)"
  quota="$(json_get "$meta" quota_project)"
  gcloud_config="$(json_get "$meta" gcloud_config)"
  region="$(json_get "$meta" region)"
  zone="$(json_get "$meta" zone)"
  [[ -n "$gcloud_config" ]] || gcloud_config="$name"

  if [[ -n "$project_override" ]]; then
    project="$(resolve_project_id "$name" "$project_override")"
    quota="$project"
    json_write_meta "$meta" project "$project" quota_project "$quota"
  else
    [[ -n "$quota" ]] || quota="$project"
  fi

  # Update ADC quota before gcloud config so set-project does not warn about mismatch
  python3 -c '
import json, sys
path, quota = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
if quota:
    data["quota_project_id"] = quota
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
' "$creds" "$quota"
  secure_dir_700 "$(context_dir "$name")"
  secure_file_600 "$creds"
  sync_well_known_adc "$name"

  # Keep named gcloud configuration aligned with selected project
  ensure_gcloud_config "$gcloud_config" "$account" "$project" "$region" "$zone"
  activate_gcloud_config "$gcloud_config"
  echo "$name" > "$ACTIVE_FILE"

  # Export paths and non-secret ids only — stdout must be ONLY export lines
  gcpctx_emit_export GCPCTX_NAME "$name"
  gcpctx_emit_export GCPCTX_HOME "$GCPCTX_HOME"
  gcpctx_emit_export GOOGLE_APPLICATION_CREDENTIALS "$creds"
  gcpctx_emit_export GOOGLE_CLOUD_PROJECT "$project"
  gcpctx_emit_export GCLOUD_PROJECT "$project"
  gcpctx_emit_export GOOGLE_CLOUD_QUOTA_PROJECT "$quota"
  gcpctx_emit_export CLOUDSDK_CORE_PROJECT "$project"
  gcpctx_emit_export CLOUDSDK_ACTIVE_CONFIG_NAME "$gcloud_config"
}

resolve_project_id() {
  # resolve_project_id <context> <id-or-name>
  local name="$1" needle="$2"
  local projects_file
  projects_file="$(context_projects "$name")"
  if [[ -f "$projects_file" ]]; then
    python3 -c '
import json, sys
path, needle = sys.argv[1], sys.argv[2]
data = json.load(open(path))
projects = data.get("projects") or []
# exact projectId
for p in projects:
    if p.get("projectId") == needle:
        print(needle)
        raise SystemExit(0)
# exact display name (unique)
matches = [p.get("projectId") for p in projects if (p.get("name") or "") == needle]
if len(matches) == 1:
    print(matches[0])
    raise SystemExit(0)
if len(matches) > 1:
    sys.stderr.write("gcpctx: ambiguous project name %r matches: %s\n" % (needle, ", ".join(matches)))
    raise SystemExit(2)
# not in cache — pass through (may still be valid)
print(needle)
' "$projects_file" "$needle"
  else
    echo "$needle"
  fi
}

warn_if_unknown_project() {
  local name="$1" project="$2"
  local projects_file
  projects_file="$(context_projects "$name")"
  [[ -f "$projects_file" ]] || return 0
  python3 -c '
import json, sys
path, project = sys.argv[1], sys.argv[2]
projects = json.load(open(path)).get("projects") or []
ids = {p.get("projectId") for p in projects}
if project not in ids:
    sys.stderr.write("gcpctx: warning: %r not in last scan for this context (run: gcpctx scan)\n" % project)
' "$projects_file" "$project"
}

print_deactivate_exports() {
  rm -f "$ACTIVE_FILE"
  gcpctx_emit_deactivate_exports
}

want_export=false

cmd_init() {
  ensure_dirs
  local name="" project="" account="" region="me-west1" zone="me-west1-c" gcloud_config=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --project) project="$2"; shift 2 ;;
      --account) account="$2"; shift 2 ;;
      --region) region="$2"; shift 2 ;;
      --zone) zone="$2"; shift 2 ;;
      --gcloud-config) gcloud_config="$2"; shift 2 ;;
      *) die "unknown init flag: $1" ;;
    esac
  done

  [[ -n "$project" ]] || project="$(gcloud config get-value project 2>/dev/null || true)"
  [[ -n "$account" ]] || account="$(gcloud config get-value account 2>/dev/null || true)"
  [[ -n "$name" ]] || name="$project"
  [[ -n "$name" ]] || die "need --name (or an active gcloud project)"
  [[ -n "$project" ]] || die "need --project"
  [[ -n "$account" ]] || die "need --account"
  [[ -n "$gcloud_config" ]] || gcloud_config="$name"
  gcpctx_validate_context_name "$name"
  gcpctx_validate_project_id "$project"
  gcpctx_validate_account "$account"
  gcpctx_validate_region "$region"
  gcpctx_validate_zone "$zone"
  gcpctx_validate_context_name "$gcloud_config"

  local dir meta
  dir="$(context_dir "$name")"
  meta="$(context_meta "$name")"
  ensure_dirs
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  json_write_meta "$meta" \
    name "$name" \
    account "$account" \
    project "$project" \
    quota_project "$project" \
    region "$region" \
    zone "$zone" \
    gcloud_config "$gcloud_config"

  ensure_gcloud_config "$gcloud_config" "$account" "$project" "$region" "$zone"

  python3 -c '
import json, sys
name = sys.argv[1]
with open(".gcpctx", "w") as f:
    json.dump({"name": name}, f, indent=2)
    f.write("\n")
' "$name"

  info "created context '$name' (project=$project account=$account)"
  info "wrote ./.gcpctx → {\"name\":\"$name\"}"
  info "next: gcpctx login $name"
}

cmd_login() {
  ensure_dirs
  gcpctx_require_trusted_gcloud
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    name="$(read_active_name)"
  fi
  if [[ -z "$name" ]]; then
    name="$(marker_name 2>/dev/null || true)"
  fi
  [[ -n "$name" ]] || die "specify context: gcpctx login <name>"
  require_context "$name"

  local meta project account quota creds
  meta="$(context_meta "$name")"
  project="$(json_get "$meta" project)"
  account="$(json_get "$meta" account)"
  quota="$(json_get "$meta" quota_project)"
  [[ -n "$quota" ]] || quota="$project"
  creds="$(context_creds "$name")"

  info "logging in for context '$name' (account=$account project=$project)"
  info "browser will open — sign in as: $account"

  # Ensure gcloud CLI session for this account first (non-ADC)
  if ! gcloud auth list --filter="account:$account" --format='value(account)' 2>/dev/null | grep -qx "$account"; then
    gcloud auth login "$account" --brief || true
  fi

  # Activate matching configuration so ADC login inherits the right gcloud project context
  local gcloud_config
  gcloud_config="$(json_get "$meta" gcloud_config)"
  [[ -n "$gcloud_config" ]] || gcloud_config="$name"
  activate_gcloud_config "$gcloud_config" 2>/dev/null || true

  # Login writes to well-known ADC (this gcloud has no --quota-project on login)
  gcloud auth application-default login "$account"

  # Set quota project on ADC when the helper exists; always also patch JSON below
  if gcloud auth application-default set-quota-project --help &>/dev/null; then
    gcloud auth application-default set-quota-project "$quota" || info "warn: set-quota-project failed; will patch credentials JSON"
  fi

  [[ -f "$GCLOUD_ADC" ]] || die "ADC file not created at $GCLOUD_ADC"
  mkdir -p "$(context_dir "$name")"
  chmod 700 "$(context_dir "$name")" 2>/dev/null || true
  cp "$GCLOUD_ADC" "$creds"
  chmod 600 "$creds"
  secure_file_600 "$GCLOUD_ADC"

  # Force quota project on authorized_user ADC only; never print body
  python3 -c '
import json, sys
path, quota, account = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    data = json.load(f)
ctype = data.get("type") or ""
if ctype == "authorized_user":
    if quota:
        data["quota_project_id"] = quota
    if account and "account" not in data:
        data["account"] = account
elif ctype in ("service_account", "external_account"):
    # Do not inject unrelated fields into SA / WIF credentials
    pass
else:
    if quota and "quota_project_id" in data:
        data["quota_project_id"] = quota
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
' "$creds" "$quota" "$account"
  chmod 600 "$creds"

  info "saved credentials → $creds"
  info "activate with: gcpctx use $name"
}

cmd_use() {
  local name="" project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project|-p)
        [[ $# -ge 2 ]] || die "usage: gcpctx use <name> [--project PROJECT]"
        project="$2"
        shift 2
        ;;
      -*)
        die "unknown flag: $1 (usage: gcpctx use <name> [--project PROJECT])"
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        elif [[ -z "$project" ]]; then
          # allow: gcpctx use prod my-project
          project="$1"
        else
          die "usage: gcpctx use <name> [--project PROJECT]"
        fi
        shift
        ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: gcpctx use <name> [--project PROJECT]"
  require_context "$name"
  local protected
  protected="$(json_get "$(context_meta "$name")" protected)"
  if [[ "$protected" == "true" ]]; then
    info "WARNING: activating protected context '$name'"
  fi
  if [[ -n "$project" ]]; then
    project="$(resolve_project_id "$name" "$project")"
    gcpctx_validate_project_id "$project"
    warn_if_unknown_project "$name" "$project"
  fi
  if $want_export; then
    print_exports "$name" "$project"
  else
    print_exports "$name" "$project" >/dev/null
    info "activated '$name'${project:+ (project=$project)}. To set env in this shell:"
    info "  eval \"\$(gcpctx use $name${project:+ --project $project} --export)\""
    info "Or install shell/gcpctx.zsh wrapper."
    cmd_current
  fi
}

cmd_activate() {
  local name project
  name="$(marker_name)" || die "no .gcpctx marker found upward from $PWD"
  project="$(marker_project)"
  if [[ -n "$project" ]]; then
    project="$(resolve_project_id "$name" "$project")"
    warn_if_unknown_project "$name" "$project"
  fi
  if $want_export; then
    print_exports "$name" "$project"
  else
    print_exports "$name" "$project" >/dev/null
    info "activated '$name'${project:+ (project=$project)} from .gcpctx. To set env in this shell:"
    info "  eval \"\$(gcpctx activate --export)\""
    cmd_current
  fi
}

cmd_deactivate() {
  if $want_export; then
    print_deactivate_exports
  else
    print_deactivate_exports >/dev/null
    info "deactivated. To clear env in this shell:"
    info "  eval \"\$(gcpctx deactivate --export)\""
  fi
}

cmd_list() {
  ensure_dirs
  local active
  active="$(read_active_name)"
  local d name meta project account flag
  printf "%-12s %-36s %-40s %s\n" "NAME" "PROJECT" "ACCOUNT" "CREDS"
  shopt -s nullglob
  for d in "$CONTEXTS_DIR"/*/; do
    name="$(basename "$d")"
    meta="$(context_meta "$name")"
    [[ -f "$meta" ]] || continue
    project="$(json_get "$meta" project)"
    account="$(json_get "$meta" account)"
    flag="missing"
    [[ -f "$(context_creds "$name")" ]] && flag="ok"
    if [[ "$name" == "$active" ]]; then
      printf "%-12s %-36s %-40s %s\n" "$name*" "$project" "$account" "$flag"
    else
      printf "%-12s %-36s %-40s %s\n" "$name" "$project" "$account" "$flag"
    fi
  done
}

cmd_current() {
  local mode="text"
  case "${1:-}" in
    --json) mode="json" ;;
    --prompt) mode="prompt" ;;
    "") ;;
    *) die "usage: gcpctx current [--json|--prompt]" ;;
  esac

  local name
  name="$(read_active_name)"
  if [[ -z "$name" ]]; then
    if [[ "$mode" == "prompt" ]]; then
      exit 0
    fi
    if [[ "$mode" == "json" ]]; then
      echo '{"active":false}'
      exit 0
    fi
    echo "no active gcpctx context"
    exit 0
  fi

  require_context "$name"
  local meta creds project account quota gcloud_config
  meta="$(context_meta "$name")"
  creds="$(context_creds "$name")"
  project="$(json_get "$meta" project)"
  account="$(json_get "$meta" account)"
  quota="$(json_get "$meta" quota_project)"
  gcloud_config="$(json_get "$meta" gcloud_config)"
  [[ -n "$quota" ]] || quota="$project"

  case "$mode" in
    prompt)
      # Match shell prompt: (gcp:name:project) or (gcp:name)
      if [[ -n "$project" ]]; then
        printf '(gcp:%s:%s)' "$name" "$project"
      else
        printf '(gcp:%s)' "$name"
      fi
      ;;
    json)
      python3 -c '
import json, sys, os
projects_path = sys.argv[7]
scanned = 0
scanned_at = ""
if os.path.isfile(projects_path):
    try:
        cached = json.load(open(projects_path))
        scanned = len(cached.get("projects") or [])
        scanned_at = cached.get("scanned_at") or ""
    except Exception:
        pass
print(json.dumps({
  "active": True,
  "name": sys.argv[1],
  "account": sys.argv[2],
  "project": sys.argv[3],
  "quota_project": sys.argv[4],
  "gcloud_config": sys.argv[5],
  "credentials_path": sys.argv[6],
  "credentials_present": os.path.isfile(sys.argv[6]),
  "projects_scanned": scanned,
  "projects_scanned_at": scanned_at,
}, indent=2))
' "$name" "$account" "$project" "$quota" "$gcloud_config" "$creds" "$(context_projects "$name")"
      ;;
    text)
      local scanned_n="(none)"
      if [[ -f "$(context_projects "$name")" ]]; then
        scanned_n="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("projects") or []))' "$(context_projects "$name")")"
      fi
      cat <<EOF
name:        $name
account:     $account
project:     $project
quota:       $quota
gcloud:      $gcloud_config
credentials: $creds
projects:    $scanned_n scanned
EOF
      ;;
  esac
}

cmd_env() {
  local mode="export"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) mode="json"; shift ;;
      --export) mode="export"; shift ;;
      *) die "usage: gcpctx env [--export|--json]" ;;
    esac
  done
  if [[ "$mode" == "json" ]]; then
    # Prefer values that would be active after current context
    local name
    name="$(read_active_name)"
    if [[ -n "$name" ]]; then
      # Apply exports into a subshell env for JSON snapshot without printing secrets
      # shellcheck disable=SC1090
      eval "$(print_exports "$name")"
    fi
    gcpctx_emit_env_json
    return
  fi
  local name
  name="$(read_active_name)"
  [[ -n "$name" ]] || die "no active context (gcpctx use <name>)"
  want_export=true
  print_exports "$name"
}

cmd_assert() {
  local want_ctx="" want_project="" want_account=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context) want_ctx="$2"; shift 2 ;;
      --project) want_project="$2"; shift 2 ;;
      --account) want_account="$2"; shift 2 ;;
      *) die "usage: gcpctx assert [--context NAME] [--project ID] [--account EMAIL]" ;;
    esac
  done
  [[ -n "$want_ctx$want_project$want_account" ]] || die "assert requires at least one of --context/--project/--account"
  local name project account meta
  name="$(read_active_name)"
  [[ -n "$name" ]] || die "assert failed: no active context"
  meta="$(context_meta "$name")"
  project="$(json_get "$meta" project)"
  account="$(json_get "$meta" account)"
  local failed=0
  if [[ -n "$want_ctx" ]]; then
    gcpctx_validate_context_name "$want_ctx"
    if [[ "$name" != "$want_ctx" ]]; then
      echo "gcpctx: assert failed: context='$name' expected='$want_ctx'" >&2
      failed=1
    fi
  fi
  if [[ -n "$want_project" ]]; then
    gcpctx_validate_project_id "$want_project"
    if [[ "$project" != "$want_project" && "${GOOGLE_CLOUD_PROJECT:-}" != "$want_project" ]]; then
      echo "gcpctx: assert failed: project='$project' expected='$want_project'" >&2
      failed=1
    fi
  fi
  if [[ -n "$want_account" ]]; then
    gcpctx_validate_account "$want_account"
    if [[ "$account" != "$want_account" ]]; then
      echo "gcpctx: assert failed: account mismatch" >&2
      failed=1
    fi
  fi
  [[ "$failed" -eq 0 ]] || exit 1
  echo "gcpctx: assert ok"
}

cmd_protect() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: gcpctx protect <name>"
  require_context "$name"
  json_write_meta "$(context_meta "$name")" protected "true"
  info "context '$name' marked protected"
}

cmd_unprotect() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: gcpctx unprotect <name>"
  require_context "$name"
  json_write_meta "$(context_meta "$name")" protected "false"
  info "context '$name' unprotected"
}

cmd_completion() {
  local shell="${1:-}"
  case "$shell" in
    bash)
      cat <<'EOF'
_gcpctx_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local cmds="init login use project scan projects activate deactivate list current env exec history timeline snapshots replay undo doctor secrets bootstrap sync-adc shell-setup shell-path protect unprotect assert completion which version help"
  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
  fi
}
complete -F _gcpctx_completions gcpctx
EOF
      ;;
    zsh)
      cat <<'EOF'
#compdef gcpctx
_gcpctx() {
  local -a cmds
  cmds=(init login use project scan projects activate deactivate list current env exec history timeline snapshots replay undo doctor secrets bootstrap sync-adc shell-setup shell-path protect unprotect assert completion which version help)
  _describe 'command' cmds
}
compdef _gcpctx gcpctx
EOF
      ;;
    powershell|ps1)
      cat <<'EOF'
Register-ArgumentCompleter -CommandName gcpctx -ScriptBlock {
  param($wordToComplete)
  $cmds = @('init','login','use','project','scan','projects','activate','deactivate','list','current','env','exec','history','timeline','snapshots','replay','undo','doctor','secrets','bootstrap','sync-adc','shell-setup','shell-path','protect','unprotect','assert','completion','which','version','help')
  $cmds | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
    [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
  }
}
EOF
      ;;
    *) die "usage: gcpctx completion bash|zsh|powershell" ;;
  esac
}

# Shared protected-context gate for exec/undo/replay.
_gcpctx_gate_protected() {
  local name="$1" deny_protected="$2" allow_protected="$3"
  local protected
  protected="$(json_get "$(context_meta "$name")" protected)"
  if [[ "$protected" == "true" ]]; then
    if [[ "$deny_protected" == "true" ]]; then
      die "refusing to run in protected context '$name' (--deny-protected)"
    fi
    if [[ "$allow_protected" != "true" ]]; then
      if [[ ! -t 0 ]]; then
        die "protected context '$name' requires --allow-protected in non-interactive mode"
      fi
      info "WARNING: protected context '$name' — type 'yes' to continue"
      local ans
      read -r ans
      [[ "$ans" == "yes" ]] || die "aborted"
    fi
  fi
}

cmd_exec() {
  local require_ctx="" deny_protected=false allow_protected=false
  local dry_run=false want_snapshot=false undo_cmd="" install_finops=false
  ensure_dirs
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      --require-context) require_ctx="$2"; shift 2 ;;
      --deny-protected) deny_protected=true; shift ;;
      --allow-protected) allow_protected=true; shift ;;
      --dry-run) dry_run=true; shift ;;
      --snapshot) want_snapshot=true; shift ;;
      --undo-cmd) undo_cmd="$2"; shift 2 ;;
      --install-finops) install_finops=true; shift ;;
      -*) die "unknown exec flag: $1" ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || die "usage: gcpctx exec [--dry-run] [--snapshot] [--undo-cmd CMD] [--require-context NAME] [--deny-protected|--allow-protected] -- <command>..."
  local name project=""
  name="$(read_active_name)"
  if [[ -z "$name" ]]; then
    name="$(marker_name 2>/dev/null || true)"
    project="$(marker_project)"
  fi
  [[ -n "$name" ]] || die "no context (use .gcpctx or gcpctx use)"
  if [[ -n "$require_ctx" ]]; then
    gcpctx_validate_context_name "$require_ctx"
    [[ "$name" == "$require_ctx" ]] || die "exec require-context failed: active='$name' required='$require_ctx'"
  fi
  _gcpctx_gate_protected "$name" "$deny_protected" "$allow_protected"

  local classification class_json
  class_json="$(gcpctx_classify_argv "$@")"
  info "classified: $(gcpctx_classify_summary "$class_json")"

  # shellcheck disable=SC1090
  eval "$(print_exports "$name" "$project")"

  local eid="" before_dir=""
  local family action resource
  family="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["family"])' <<<"$class_json")"
  action="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["action"])' <<<"$class_json")"
  resource="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("resource") or "")' <<<"$class_json")"
  local ctx_project
  ctx_project="$(json_get "$(context_meta "$name")" project)"

  if gcpctx_history_enabled; then
    eid="$(gcpctx_history_begin)"
    before_dir="$(gcpctx_history_entry_dir "$eid")/before"
    gcpctx_history_snapshot_local "$eid" "$name"
    # Terraform state snapshot
    if [[ "$family" == "terraform" ]]; then
      local state_path="terraform.tfstate"
      local custom_state
      custom_state="$(python3 -c 'import json,sys; print((json.load(sys.stdin).get("details") or {}).get("state") or "")' <<<"$class_json")"
      [[ -n "$custom_state" ]] && state_path="$custom_state"
      if [[ -f "$state_path" ]]; then
        cp "$state_path" "$before_dir/terraform.tfstate" 2>/dev/null || true
      fi
    fi
    # Cloud Run describe
    if [[ "$family" == "cloudrun" && -n "$resource" ]]; then
      gcloud run services describe "$resource" --format=json >"$before_dir/service.json" 2>/dev/null || true
      local rev
      rev="$(python3 -c '
import json,sys
try:
  d=json.load(open(sys.argv[1]))
  print(d.get("status",{}).get("latestReadyRevisionName") or "")
except Exception:
  print("")
' "$before_dir/service.json" 2>/dev/null || true)"
      if [[ -n "$rev" ]]; then
        echo "$rev" >"$before_dir/revision.txt"
      fi
    fi
  fi

  local snaps_json="[]"
  if [[ "$family" == "bigquery" && "$action" == "rm" && -n "$resource" && -n "$eid" ]]; then
    snaps_json="$(gcpctx_bq_prepare_delete "$eid" "$resource" "$ctx_project")"
  elif $want_snapshot && [[ "$family" == "bigquery" && -n "$resource" && -n "$eid" ]]; then
    snaps_json="$(gcpctx_bq_prepare_delete "$eid" "$resource" "$ctx_project")"
  fi

  if $dry_run; then
    info "DRY-RUN — would execute: $*"
    info "plan: family=$family action=$action resource=$resource"
    if [[ -n "$undo_cmd" ]]; then
      info "custom undo-cmd: $undo_cmd"
    fi
    local cost_file=""
    if $install_finops; then
      GCPCTX_INSTALL_FINOPS=1
      export GCPCTX_INSTALL_FINOPS
    fi
    if gcpctx_finops_offer_install; then
      if [[ -n "$eid" ]]; then
        cost_file="$(gcpctx_history_entry_dir "$eid")/cost.json"
      else
        cost_file="$(mktemp "${GCPCTX_HOME}/tmp/cost.XXXXXX")"
      fi
      local region
      region="$(json_get "$(context_meta "$name")" region)"
      [[ -n "$region" ]] || region="US"
      gcpctx_finops_estimate "$cost_file" "$ctx_project" "$region" "$@" || true
      if [[ -f "$cost_file" ]]; then
        info "cost estimate (gemlake-finops):"
        cat "$cost_file" >&2 || true
      fi
    else
      info "cost omitted (gemlake-finops unavailable)"
    fi
    if gcpctx_history_enabled && [[ -n "$eid" ]]; then
      local ts pii_json argv_json
      ts="$(python3 -c 'import datetime; print(datetime.datetime.utcnow().replace(microsecond=0).isoformat()+"Z")')"
      pii_json="$(gcpctx_history_pii_json)"
      argv_json="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")"
      python3 -c '
import json, sys
id, ts, class_s, pii_s, argv_s, snaps_s, undo_cmd = sys.argv[1:8]
ev = {
  "id": id,
  "ts": ts,
  "kind": "dry_run",
  "argv": json.loads(argv_s),
  "cwd": json.loads(pii_s).get("cwd"),
  "exit_code": 0,
  "pii": json.loads(pii_s),
  "classification": json.loads(class_s),
  "undo": {"status": "unsupported"},
  "snapshots": json.loads(snaps_s),
}
if undo_cmd:
  ev["undo_cmd"] = undo_cmd
print(json.dumps(ev, indent=2))
' "$eid" "$ts" "$class_json" "$pii_json" "$argv_json" "$snaps_json" "$undo_cmd" \
        | gcpctx_history_finalize "$eid" -
      if [[ -n "${cost_file:-}" && -f "$cost_file" ]]; then
        cp "$cost_file" "$(gcpctx_history_entry_dir "$eid")/cost.json" 2>/dev/null || true
      fi
    fi
    return 0
  fi

  # Run child (stay parent for journaling)
  local exit_code=0
  local out_file err_file
  if [[ -n "$eid" ]]; then
    out_file="$(gcpctx_history_entry_dir "$eid")/after/stdout.txt"
    err_file="$(gcpctx_history_entry_dir "$eid")/after/stderr.txt"
    set +e
    "$@" >"$out_file" 2>"$err_file"
    exit_code=$?
    set -e
    # Replay captured streams to the user
    [[ -s "$out_file" ]] && cat "$out_file"
    [[ -s "$err_file" ]] && cat "$err_file" >&2
  else
    set +e
    "$@"
    exit_code=$?
    set -e
  fi

  if gcpctx_history_enabled && [[ -n "$eid" ]]; then
    local ts pii_json argv_json
    ts="$(python3 -c 'import datetime; print(datetime.datetime.utcnow().replace(microsecond=0).isoformat()+"Z")')"
    pii_json="$(gcpctx_history_pii_json)"
    argv_json="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")"
    # Attach cloudrun revision snapshot metadata
    if [[ "$family" == "cloudrun" && -f "$before_dir/revision.txt" ]]; then
      local rev
      rev="$(tr -d '[:space:]' <"$before_dir/revision.txt")"
      snaps_json="$(python3 -c '
import json,sys
snaps=json.loads(sys.argv[1]); rev=sys.argv[2]; res=sys.argv[3]
snaps.append({"kind":"cloudrun_revision","resource":rev,"service":res})
print(json.dumps(snaps))
' "$snaps_json" "$rev" "$resource")"
    fi
    if [[ "$family" == "terraform" && -f "$before_dir/terraform.tfstate" ]]; then
      snaps_json="$(python3 -c '
import json,sys
snaps=json.loads(sys.argv[1])
snaps.append({"kind":"local_before","resource":"before/terraform.tfstate","path":None})
print(json.dumps(snaps))
' "$snaps_json")"
    fi
    python3 -c '
import json, sys
id, ts, class_s, pii_s, argv_s, snaps_s, undo_cmd, exit_code = sys.argv[1:9]
ev = {
  "id": id,
  "ts": ts,
  "kind": "exec",
  "argv": json.loads(argv_s),
  "cwd": json.loads(pii_s).get("cwd"),
  "exit_code": int(exit_code),
  "pii": json.loads(pii_s),
  "classification": json.loads(class_s),
  "undo": {"status": "ready"},
  "snapshots": json.loads(snaps_s),
}
if undo_cmd:
  ev["undo_cmd"] = undo_cmd
if __import__("os").environ.get("GCPCTX_REPLAY_OF"):
  ev["kind"] = "replay"
  ev["replay_of"] = __import__("os").environ["GCPCTX_REPLAY_OF"]
print(json.dumps(ev, indent=2))
' "$eid" "$ts" "$class_json" "$pii_json" "$argv_json" "$snaps_json" "$undo_cmd" "$exit_code" \
      >"$(gcpctx_history_entry_dir "$eid")/event.json.tmp"
    # Build inverse plan
    local inv_args=()
    [[ -n "$undo_cmd" ]] && inv_args=(--undo-cmd "$undo_cmd")
    python3 "$_GCPCTX_ROOT/lib/undo.py" "$(gcpctx_history_entry_dir "$eid")/event.json.tmp" ${inv_args[@]+"${inv_args[@]}"} \
      >"$(gcpctx_history_entry_dir "$eid")/inverse.json"
    gcpctx_chmod_600 "$(gcpctx_history_entry_dir "$eid")/inverse.json"
    local undo_status
    undo_status="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status","unsupported"))' "$(gcpctx_history_entry_dir "$eid")/inverse.json")"
    python3 -c '
import json, sys
path, status = sys.argv[1], sys.argv[2]
with open(path) as f:
  ev = json.load(f)
ev["undo"] = {"status": status}
with open(path, "w") as f:
  json.dump(ev, f, indent=2)
  f.write("\n")
' "$(gcpctx_history_entry_dir "$eid")/event.json.tmp" "$undo_status"
    gcpctx_history_finalize "$eid" "$(gcpctx_history_entry_dir "$eid")/event.json.tmp"
    rm -f "$(gcpctx_history_entry_dir "$eid")/event.json.tmp"
  fi

  return "$exit_code"
}

cmd_history() {
  local sub="${1:-}"
  if [[ "$sub" == "show" ]]; then
    shift
    local id="${1:-}"
    [[ -n "$id" ]] || die "usage: gcpctx history show <id>"
    gcpctx_history_show_json "$id" || die "unknown history id '$id'"
    return 0
  fi
  if [[ "$sub" == "snapshots" ]]; then
    shift
    cmd_snapshots "$@"
    return 0
  fi
  local json=false limit=50 ctx="" proj=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --limit) limit="$2"; shift 2 ;;
      --context) ctx="$2"; shift 2 ;;
      --project) proj="$2"; shift 2 ;;
      -*) die "unknown history flag: $1" ;;
      *) die "usage: gcpctx history [--json] [--limit N] [--context NAME] [--project ID] | show <id> | snapshots" ;;
    esac
  done
  ensure_dirs
  if ! gcpctx_history_enabled; then
    info "history disabled (config or GCPCTX_HISTORY=0)"
    if $json; then echo "[]"; fi
    return 0
  fi
  local data
  data="$(gcpctx_history_list_json "$limit" "$ctx" "$proj")"
  if $json; then
    echo "$data"
  else
    python3 -c '
import json, sys
events = json.load(sys.stdin)
if not events:
    print("(no history)")
    raise SystemExit(0)
for ev in events:
    argv = ev.get("argv") or []
    cmd = " ".join(argv) if isinstance(argv, list) else str(argv)
    if len(cmd) > 80:
        cmd = cmd[:77] + "..."
    undo = (ev.get("undo") or {}).get("status") or "-"
    print("{ts}  {id}  [{kind}] exit={exit} undo={undo}  {ctx}/{proj}  {cmd}".format(
      ts=ev.get("ts",""),
      id=ev.get("id",""),
      kind=ev.get("kind") or ev.get("subcommand") or "?",
      exit=ev.get("exit_code",""),
      undo=undo,
      ctx=(ev.get("pii") or {}).get("context") or ev.get("context") or "-",
      proj=(ev.get("pii") or {}).get("project") or ev.get("project") or "-",
      cmd=cmd,
    ))
' <<<"$data"
  fi
}

cmd_timeline() {
  cmd_history "$@"
}

cmd_snapshots() {
  local json=false proj=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --project) proj="$2"; shift 2 ;;
      -*) die "unknown snapshots flag: $1" ;;
      *) die "usage: gcpctx snapshots [--json] [--project ID]" ;;
    esac
  done
  ensure_dirs
  export GCPCTX_BQ_TIMETRAVEL_DAYS
  GCPCTX_BQ_TIMETRAVEL_DAYS="$(gcpctx_bq_timetravel_days)"
  local data
  data="$(gcpctx_history_snapshots_json "$proj")"
  if $json; then
    echo "$data"
  else
    python3 -c '
import json, sys, datetime
rows = json.load(sys.stdin)
if not rows:
    print("(no snapshots)")
    raise SystemExit(0)
for r in rows:
    exists = "exists" if r.get("exists") else "missing"
    if r.get("kind") == "bq_timetravel" and not r.get("exists"):
        exists = "expired"
    usable = "usable" if r.get("usable_for_undo") else "not-usable"
    exp = r.get("expires")
    exp_s = ""
    if isinstance(exp, (int, float)) and exp > 1e11:
        exp_s = datetime.datetime.utcfromtimestamp(exp/1000).isoformat() + "Z"
    elif exp:
        exp_s = str(exp)
    print("{kind}: {resource}  {exists}/{usable}  event={eid}  expires={exp}".format(
      kind=r.get("kind"),
      resource=r.get("resource"),
      exists=exists,
      usable=usable,
      eid=r.get("event_id"),
      exp=exp_s or "-",
    ))
' <<<"$data"
  fi
}

cmd_replay() {
  local id="" ctx="" proj="" dry_run=false install_finops=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --context) ctx="$2"; shift 2 ;;
      --project) proj="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      --install-finops) install_finops=true; shift ;;
      -*) die "unknown replay flag: $1" ;;
      *)
        if [[ -z "$id" ]]; then id="$1"; shift
        else die "usage: gcpctx replay <id> [--context NAME] [--project ID] [--dry-run]"; fi
        ;;
    esac
  done
  [[ -n "$id" ]] || die "usage: gcpctx replay <id> [--context NAME] [--project ID] [--dry-run]"
  local ef
  ef="$(gcpctx_history_entry_dir "$id")/event.json"
  [[ -f "$ef" ]] || die "unknown history id '$id'"
  local argv_json
  argv_json="$(python3 -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1])).get("argv") or []))' "$ef")"
  if [[ -n "$ctx" ]]; then
    require_context "$ctx"
    if [[ -n "$proj" ]]; then
      eval "$(print_exports "$ctx" "$proj")"
    else
      eval "$(print_exports "$ctx" "")"
    fi
  elif [[ -n "$proj" ]]; then
    local an
    an="$(read_active_name)"
    [[ -n "$an" ]] || die "no active context for --project"
    eval "$(print_exports "$an" "$proj")"
  fi
  local -a replay_argv=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && replay_argv+=("$line")
  done < <(python3 -c 'import json,sys; [print(a) for a in json.loads(sys.argv[1])]' "$argv_json")
  [[ ${#replay_argv[@]} -gt 0 ]] || die "event has empty argv"
  info "replaying $id: ${replay_argv[*]}"
  export GCPCTX_REPLAY_OF="$id"
  local -a flags=()
  $dry_run && flags+=(--dry-run)
  $install_finops && flags+=(--install-finops)
  cmd_exec ${flags[@]+"${flags[@]}"} -- "${replay_argv[@]}"
  local rc=$?
  unset GCPCTX_REPLAY_OF
  return "$rc"
}

cmd_undo() {
  local id="" dry_run=false install_finops=false deny_protected=false allow_protected=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --install-finops) install_finops=true; shift ;;
      --deny-protected) deny_protected=true; shift ;;
      --allow-protected) allow_protected=true; shift ;;
      -*) die "unknown undo flag: $1" ;;
      *)
        if [[ -z "$id" ]]; then id="$1"; shift
        else die "usage: gcpctx undo [<id>] [--dry-run]"; fi
        ;;
    esac
  done
  ensure_dirs
  if [[ -z "$id" ]]; then
    id="$(gcpctx_history_last_ready_id)"
  fi
  [[ -n "$id" ]] || die "no undo-ready history entry"
  local ef inv
  ef="$(gcpctx_history_entry_dir "$id")/event.json"
  inv="$(gcpctx_history_entry_dir "$id")/inverse.json"
  [[ -f "$ef" ]] || die "unknown history id '$id'"
  if [[ ! -f "$inv" ]]; then
    python3 "$_GCPCTX_ROOT/lib/undo.py" "$ef" >"$inv"
    gcpctx_chmod_600 "$inv"
  fi
  local status
  status="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status","unsupported"))' "$inv")"
  if [[ "$status" == "unsupported" ]]; then
    die "undo unsupported for event $id (see inverse.json notes)"
  fi
  local name
  name="$(read_active_name)"
  if [[ -n "$name" ]]; then
    _gcpctx_gate_protected "$name" "$deny_protected" "$allow_protected"
  fi
  info "undo plan for $id:"
  cat "$inv" >&2
  if $dry_run; then
    if $install_finops; then
      export GCPCTX_INSTALL_FINOPS=1
    fi
    if gcpctx_finops_offer_install; then
      local cost_file project region
      cost_file="$(gcpctx_history_entry_dir "$id")/cost-undo.json"
      project="$(python3 -c 'import json,sys; print((json.load(open(sys.argv[1])).get("pii") or {}).get("project") or "")' "$ef")"
      region="US"
      if [[ -n "$name" ]]; then
        region="$(json_get "$(context_meta "$name")" region)"
        [[ -n "$region" ]] || region="US"
      fi
      gcpctx_finops_estimate "$cost_file" "$project" "$region" undo "$id" || true
      [[ -f "$cost_file" ]] && { info "cost:"; cat "$cost_file" >&2; }
    fi
    info "DRY-RUN — not applying undo"
    return 0
  fi

  local family
  family="$(python3 -c 'import json,sys; print((json.load(open(sys.argv[1])).get("classification") or {}).get("family") or "")' "$ef")"
  local rc=0
  case "$family" in
    bigquery)
      set +e
      gcpctx_bq_execute_undo "$inv"
      rc=$?
      set -e
      if [[ "$rc" -eq 2 ]]; then
        gcpctx_history_set_undo_status "$id" "expired"
        die "BQ undo expired (snapshot missing and time travel window lapsed)"
      fi
      ;;
    gcpctx_local)
      local before meta_src active_src
      before="$(gcpctx_history_entry_dir "$id")/before"
      meta_src="$before/meta.json"
      active_src="$before/active"
      if [[ -f "$meta_src" ]]; then
        local ctx_name
        ctx_name="$(json_get "$meta_src" name)"
        if [[ -n "$ctx_name" ]] && context_exists "$ctx_name"; then
          cp "$meta_src" "$(context_meta "$ctx_name")"
          gcpctx_chmod_600 "$(context_meta "$ctx_name")"
        fi
      fi
      if [[ -f "$active_src" ]]; then
        cp "$active_src" "$ACTIVE_FILE"
      fi
      info "restored local context from before/ snapshot"
      ;;
    *)
      # Execute shell / gcloud steps from inverse
      set +e
      python3 -c '
import json, sys, subprocess, shlex, os
inv = json.load(open(sys.argv[1]))
ev = json.load(open(sys.argv[2]))
for step in inv.get("steps") or []:
    t = step.get("type")
    if t == "shell_string":
        r = subprocess.run(step["cmd"], shell=True)
        if r.returncode != 0:
            raise SystemExit(r.returncode)
    elif t == "shell":
        r = subprocess.run(step.get("argv") or [])
        if r.returncode != 0:
            raise SystemExit(r.returncode)
    elif t == "gcloud":
        r = subprocess.run(["gcloud"] + list(step.get("argv") or []))
        if r.returncode != 0:
            raise SystemExit(r.returncode)
    elif t == "gcloud_invert_iam":
        argv = list(ev.get("argv") or [])
        frm, to = step["from"], step["to"]
        argv = [to if a == frm else a for a in argv]
        # drop leading gcloud if present — we add it
        if argv and argv[0].endswith("gcloud"):
            argv = argv[1:]
        r = subprocess.run(["gcloud"] + argv)
        if r.returncode != 0:
            raise SystemExit(r.returncode)
    elif t == "terraform_state_restore":
        src = os.path.join(os.path.dirname(sys.argv[2]), step.get("state_snapshot") or "before/terraform.tfstate")
        # event.json is in entries/id/; before is sibling
        entry = os.path.dirname(sys.argv[2])
        src = os.path.join(entry, "before", "terraform.tfstate")
        cwd = step.get("cwd") or ev.get("cwd") or "."
        dst = os.path.join(cwd, "terraform.tfstate")
        if not os.path.isfile(src):
            print("missing terraform state snapshot", file=sys.stderr)
            raise SystemExit(1)
        import shutil
        shutil.copy2(src, dst)
        print(f"restored {dst} from snapshot; run terraform apply manually to converge", file=sys.stderr)
    elif t == "restore_local_meta":
        pass  # handled in bash for gcpctx_local
    else:
        print(f"unknown step type {t}", file=sys.stderr)
        raise SystemExit(1)
' "$inv" "$ef"
      rc=$?
      set -e
      ;;
  esac
  if [[ "$rc" -ne 0 ]]; then
    die "undo failed for $id (exit $rc)"
  fi
  gcpctx_history_set_undo_status "$id" "applied"
  # Journal the undo as a new event
  if gcpctx_history_enabled; then
    local uid
    uid="$(gcpctx_history_begin)"
    local ts pii_json
    ts="$(python3 -c 'import datetime; print(datetime.datetime.utcnow().replace(microsecond=0).isoformat()+"Z")')"
    pii_json="$(gcpctx_history_pii_json)"
    python3 -c '
import json, sys
uid, ts, pii_s, orig = sys.argv[1:5]
ev = {
  "id": uid,
  "ts": ts,
  "kind": "undo",
  "argv": ["undo", orig],
  "cwd": json.loads(pii_s).get("cwd"),
  "exit_code": 0,
  "pii": json.loads(pii_s),
  "classification": {"family": "gcpctx_local", "action": "undo"},
  "undo": {"status": "unsupported"},
  "undo_of": orig,
  "snapshots": [],
}
print(json.dumps(ev, indent=2))
' "$uid" "$ts" "$pii_json" "$id" | gcpctx_history_finalize "$uid" -
  fi
  info "undo applied for $id"
}

cmd_scan() {
  local name="" json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      -*) die "unknown flag: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  if [[ -z "$name" ]]; then
    name="$(read_active_name)"
  fi
  if [[ -z "$name" ]]; then
    name="$(marker_name 2>/dev/null || true)"
  fi
  [[ -n "$name" ]] || die "specify context: gcpctx scan <name>"
  require_context "$name"

  local meta account gcloud_config projects_file
  meta="$(context_meta "$name")"
  account="$(json_get "$meta" account)"
  gcloud_config="$(json_get "$meta" gcloud_config)"
  [[ -n "$gcloud_config" ]] || gcloud_config="$name"
  projects_file="$(context_projects "$name")"

  info "scanning projects for context '$name' (account=$account)…"
  ensure_dirs
  gcpctx_require_trusted_gcloud
  local err_file
  err_file="$GCPCTX_HOME/tmp/scan-$$.err"
  # Prefer named configuration so the correct account is used
  if ! gcloud --configuration="$gcloud_config" projects list --format=json >"${projects_file}.tmp" 2>"$err_file"; then
    rm -f "${projects_file}.tmp"
    cat "$err_file" >&2 || true
    rm -f "$err_file"
    die "projects list failed (is account logged in? gcloud auth login $account)"
  fi
  rm -f "$err_file"
  python3 -c '
import json, sys, datetime
raw_path, out_path, account, ctx = sys.argv[1:5]
raw = json.load(open(raw_path))
projects = []
for p in raw:
    state = p.get("lifecycleState") or p.get("state") or "ACTIVE"
    if state in ("DELETE_REQUESTED", "DELETED"):
        continue
    projects.append({
        "projectId": p.get("projectId") or "",
        "name": p.get("name") or "",
        "projectNumber": str(p.get("projectNumber") or ""),
        "lifecycleState": state,
    })
projects.sort(key=lambda x: x["projectId"])
out = {
    "scanned_at": datetime.datetime.utcnow().replace(microsecond=0).isoformat() + "Z",
    "account": account,
    "context": ctx,
    "projects": projects,
}
with open(out_path, "w") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
' "${projects_file}.tmp" "$projects_file" "$account" "$name"
  rm -f "${projects_file}.tmp"

  if $json; then
    cat "$projects_file"
  else
    local count
    count="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("projects") or []))' "$projects_file")"
    info "cached $count project(s) → $projects_file"
    cmd_projects "$name"
  fi
}

cmd_projects() {
  local name="" json=false refresh=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true; shift ;;
      --refresh) refresh=true; shift ;;
      -*) die "unknown flag: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  if [[ -z "$name" ]]; then
    name="$(read_active_name)"
  fi
  if [[ -z "$name" ]]; then
    name="$(marker_name 2>/dev/null || true)"
  fi
  [[ -n "$name" ]] || die "specify context: gcpctx projects <name>"
  require_context "$name"

  if $refresh || [[ ! -f "$(context_projects "$name")" ]]; then
    local scan_args=("$name")
    $json && scan_args+=(--json)
    cmd_scan "${scan_args[@]}"
    return
  fi

  local projects_file active_project
  projects_file="$(context_projects "$name")"
  active_project="$(json_get "$(context_meta "$name")" project)"

  if $json; then
    cat "$projects_file"
    return
  fi

  python3 -c '
import json, sys
path, active = sys.argv[1], sys.argv[2]
data = json.load(open(path))
projects = data.get("projects") or []
print("%-36s %-40s %s" % ("PROJECT_ID", "NAME", "ACTIVE"))
for p in projects:
    pid = p.get("projectId") or ""
    mark = "*" if pid == active else ""
    print("%-36s %-40s %s" % (pid, (p.get("name") or "")[:40], mark))
print("")
print("context=%s account=%s scanned_at=%s count=%d" % (
    data.get("context") or "",
    data.get("account") or "",
    data.get("scanned_at") or "",
    len(projects),
))
' "$projects_file" "$active_project"
}

cmd_project() {
  local sub="${1:-}"
  case "$sub" in
    list|ls)
      shift
      cmd_projects "$@"
      return
      ;;
    scan)
      shift
      cmd_scan "$@"
      return
      ;;
    set)
      shift
      ;;
    ""|-h|--help)
      die "usage: gcpctx project <project-id> | gcpctx project set <project-id> | gcpctx project list"
      ;;
    -*)
      die "usage: gcpctx project <project-id>"
      ;;
  esac

  local project="${1:-}"
  [[ -n "$project" ]] || die "usage: gcpctx project <project-id>"
  local name
  name="$(read_active_name)"
  [[ -n "$name" ]] || die "no active context (gcpctx use <name> first)"
  require_context "$name"
  project="$(resolve_project_id "$name" "$project")"
  warn_if_unknown_project "$name" "$project"

  if $want_export; then
    print_exports "$name" "$project"
  else
    print_exports "$name" "$project" >/dev/null
    info "set project '$project' on context '$name'. To set env in this shell:"
    info "  eval \"\$(gcpctx project $project --export)\""
    cmd_current
  fi
}

cmd_doctor() {
  local fix=false json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) fix=true; shift ;;
      --json) json=true; shift ;;
      *) die "usage: gcpctx doctor [--fix] [--json]" ;;
    esac
  done
  if $fix; then
    cmd_secrets_fix
  fi

  gcpctx_doctor_reset
  ensure_dirs
  local name project account quota gcloud_config creds
  name="$(read_active_name)"

  local gcloud_bin="" perms_ok=false
  if gcpctx_try_resolve_gcloud; then
    gcloud_bin="$(gcpctx_gcloud_bin)"
    if [[ "${_GCPCTX_GCLOUD_TRUSTED:-0}" != "1" ]]; then
      gcpctx_doctor_add GCLOUD_UNTRUSTED warn "gcloud binary may be PATH-hijackable; set GCPCTX_GCLOUD" "$gcloud_bin"
    fi
  else
    gcpctx_doctor_add GCLOUD_MISSING error "gcloud not found on PATH (set GCPCTX_GCLOUD)"
  fi

  if gcpctx_perms_supported "$GCPCTX_HOME"; then
    perms_ok=true
  else
    gcpctx_doctor_add PERMS_UNSUPPORTED warn "Unix permission bits not enforceable on this filesystem (common on some Windows mounts)"
  fi

  if ! $json; then
    echo "gcpctx doctor"
    echo "-------------"
    echo "GCPCTX_HOME=$GCPCTX_HOME"
    echo "active_file=$( [[ -f $ACTIVE_FILE ]] && cat "$ACTIVE_FILE" || echo '(none)' )"
    echo "env GCPCTX_NAME=${GCPCTX_NAME:-"(unset)"}"
    echo "env GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-"(unset)"}"
    echo "env GOOGLE_CLOUD_QUOTA_PROJECT=${GOOGLE_CLOUD_QUOTA_PROJECT:-"(unset)"}"
    echo "env GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-"(unset)"}"
    echo "env CLOUDSDK_ACTIVE_CONFIG_NAME=${CLOUDSDK_ACTIVE_CONFIG_NAME:-"(unset)"}"
    echo "gcloud_bin=${gcloud_bin:-"(missing)"}"
    echo "perms_supported=$perms_ok"
  fi

  local g_account="" g_project="" g_config=""
  if [[ -n "$gcloud_bin" ]]; then
    g_account="$(gcloud config get-value account 2>/dev/null || true)"
    g_project="$(gcloud config get-value project 2>/dev/null || true)"
    g_config="$(cat "${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/active_config" 2>/dev/null || true)"
    if ! $json; then
      echo "gcloud account=$g_account project=$g_project configuration=$g_config"
    fi
  fi

  if [[ -d "$GCPCTX_HOME" ]]; then
    local home_mode
    home_mode="$(file_mode_octal "$GCPCTX_HOME")"
    if ! $json; then
      echo "store mode=$home_mode ($GCPCTX_HOME)"
    fi
    if $perms_ok && mode_too_open "$home_mode"; then
      gcpctx_doctor_add STORE_PERMS_OPEN error "$GCPCTX_HOME is group/world accessible (mode $home_mode); run: gcpctx secrets fix" "$GCPCTX_HOME"
    fi
  else
    gcpctx_doctor_add STORE_MISSING warn "$GCPCTX_HOME missing" "$GCPCTX_HOME"
  fi

  local adc_quota="" adc_type=""
  if [[ -f "$GCLOUD_ADC" ]]; then
    adc_quota="$(adc_meta_get "$GCLOUD_ADC" quota_project_id)"
    adc_type="$(adc_meta_get "$GCLOUD_ADC" type)"
    if ! $json; then
      echo "well-known ADC type=$adc_type quota_project_id=$adc_quota"
    fi
    local adc_mode
    adc_mode="$(file_mode_octal "$GCLOUD_ADC")"
    if $perms_ok && mode_too_open "$adc_mode"; then
      gcpctx_doctor_add ADC_PERMS_OPEN error "well-known ADC is group/world readable (mode $adc_mode); run: gcpctx secrets fix" "$GCLOUD_ADC"
    fi
  else
    if ! $json; then
      echo "well-known ADC: missing"
    fi
    gcpctx_doctor_add ADC_MISSING error "well-known ADC missing" "$GCLOUD_ADC"
  fi

  if [[ -d "$CONTEXTS_DIR" ]]; then
    local d cred mode
    shopt -s nullglob
    for d in "$CONTEXTS_DIR"/*/; do
      cred="${d}credentials.json"
      if [[ -f "$cred" ]]; then
        mode="$(file_mode_octal "$cred")"
        if $perms_ok && mode_too_open "$mode"; then
          gcpctx_doctor_add CRED_PERMS_OPEN error "credentials world/group-accessible (mode $mode)" "$cred"
        fi
      fi
      mode="$(file_mode_octal "$d")"
      if $perms_ok && mode_too_open "$mode"; then
        gcpctx_doctor_add CONTEXT_DIR_PERMS_OPEN error "context dir group/world-accessible (mode $mode)" "$d"
      fi
    done
  fi

  if [[ -d "$GCPCTX_HOME/history" ]]; then
    local hmode
    hmode="$(file_mode_octal "$GCPCTX_HOME/history")"
    if $perms_ok && mode_too_open "$hmode"; then
      gcpctx_doctor_add HISTORY_PERMS_OPEN error "history dir group/world-accessible (mode $hmode); run: gcpctx secrets fix" "$GCPCTX_HOME/history"
    fi
    if ! $json; then
      echo "history: $GCPCTX_HOME/history (mode=$hmode)"
    fi
  fi

  if [[ -z "$name" ]]; then
    gcpctx_doctor_add NO_ACTIVE_CONTEXT warn "no active gcpctx context"
  else
    require_context "$name"
    local meta
    meta="$(context_meta "$name")"
    creds="$(context_creds "$name")"
    project="$(json_get "$meta" project)"
    account="$(json_get "$meta" account)"
    quota="$(json_get "$meta" quota_project)"
    gcloud_config="$(json_get "$meta" gcloud_config)"
    [[ -n "$quota" ]] || quota="$project"
    if ! $json; then
      echo "context $name → project=$project account=$account quota=$quota gcloud=$gcloud_config"
    fi

    [[ -f "$creds" ]] || gcpctx_doctor_add MISSING_CREDENTIALS error "missing credentials" "$creds"

    if [[ -n "${GOOGLE_CLOUD_PROJECT:-}" && "$GOOGLE_CLOUD_PROJECT" != "$project" ]]; then
      gcpctx_doctor_add ENV_PROJECT_MISMATCH error "GOOGLE_CLOUD_PROJECT ($GOOGLE_CLOUD_PROJECT) != context project ($project)"
    fi
    if [[ -n "${GOOGLE_CLOUD_QUOTA_PROJECT:-}" && "$GOOGLE_CLOUD_QUOTA_PROJECT" != "$quota" ]]; then
      gcpctx_doctor_add ENV_QUOTA_MISMATCH error "GOOGLE_CLOUD_QUOTA_PROJECT ($GOOGLE_CLOUD_QUOTA_PROJECT) != context quota ($quota)"
    fi
    if [[ -n "$gcloud_bin" && "$g_project" != "$project" ]]; then
      gcpctx_doctor_add GCLOUD_PROJECT_MISMATCH error "gcloud project ($g_project) != context project ($project)"
    fi
    if [[ -n "$gcloud_bin" && "$g_account" != "$account" ]]; then
      gcpctx_doctor_add GCLOUD_ACCOUNT_MISMATCH error "gcloud account ($g_account) != context account ($account)"
    fi
    if [[ -n "$adc_quota" && "$adc_quota" != "$quota" ]]; then
      gcpctx_doctor_add ADC_QUOTA_MISMATCH error "ADC quota_project_id ($adc_quota) != context quota ($quota)"
    fi
    if [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]]; then
      case "${GOOGLE_APPLICATION_CREDENTIALS}" in
        "$GCPCTX_HOME"/contexts/*) ;;
        *)
          gcpctx_doctor_add GAC_PATH_OUTSIDE_STORE error "GOOGLE_APPLICATION_CREDENTIALS not under $GCPCTX_HOME/contexts/" "${GOOGLE_APPLICATION_CREDENTIALS}"
          ;;
      esac
      if [[ "$GOOGLE_APPLICATION_CREDENTIALS" != "$creds" ]]; then
        gcpctx_doctor_add GAC_PATH_MISMATCH error "GOOGLE_APPLICATION_CREDENTIALS points elsewhere" "${GOOGLE_APPLICATION_CREDENTIALS}"
      fi
    fi
  fi

  if $json; then
    gcpctx_doctor_emit_json "$gcloud_bin" "$perms_ok" "$name"
  else
    gcpctx_doctor_emit_text
  fi

  local err_n
  err_n="$(gcpctx_doctor_error_count)"
  if [[ "$err_n" -eq 0 ]]; then
    if ! $json; then
      echo "OK: no errors detected"
    fi
    return 0
  fi
  if ! $json; then
    echo "FAIL: $err_n error(s) — run: eval \"\$(gcpctx use <name> --export)\" or gcpctx secrets fix"
  fi
  exit 1
}

cmd_secrets() {
  local sub="${1:-}"
  case "$sub" in
    fix) cmd_secrets_fix ;;
    *) die "usage: gcpctx secrets fix" ;;
  esac
}

cmd_secrets_fix() {
  ensure_dirs
  info "hardening permissions under $GCPCTX_HOME"
  chmod 700 "$GCPCTX_HOME" 2>/dev/null || true
  chmod 700 "$CONTEXTS_DIR" 2>/dev/null || true
  mkdir -p "$GCPCTX_HOME/tmp"
  chmod 700 "$GCPCTX_HOME/tmp" 2>/dev/null || true
  if [[ -d "$GCPCTX_HOME/history" ]]; then
    chmod 700 "$GCPCTX_HOME/history" 2>/dev/null || true
    chmod 700 "$GCPCTX_HOME/history/entries" 2>/dev/null || true
    find "$GCPCTX_HOME/history" -type f -exec chmod 600 {} \; 2>/dev/null || true
    find "$GCPCTX_HOME/history" -type d -exec chmod 700 {} \; 2>/dev/null || true
  fi
  if [[ -f "$GCPCTX_HOME/config.json" ]]; then
    chmod 600 "$GCPCTX_HOME/config.json" 2>/dev/null || true
  fi
  local d cred
  shopt -s nullglob
  for d in "$CONTEXTS_DIR"/*/; do
    chmod 700 "$d" 2>/dev/null || true
    cred="${d}credentials.json"
    if [[ -f "$cred" ]]; then
      chmod 600 "$cred" 2>/dev/null || true
    fi
  done
  if [[ -f "$GCLOUD_ADC" ]]; then
    chmod 600 "$GCLOUD_ADC" 2>/dev/null || true
  fi
  info "done (credentials remain local; contents never printed)"
}

cmd_shell_path() {
  local root kind="${1:-}"
  root="$(package_root)"
  case "$kind" in
    ""|--zsh|zsh)
      [[ -f "$root/shell/gcpctx.zsh" ]] || die "shell hook not found at $root/shell/gcpctx.zsh"
      echo "$root/shell/gcpctx.zsh"
      ;;
    --bash|bash)
      [[ -f "$root/shell/gcpctx.bash" ]] || die "shell hook not found at $root/shell/gcpctx.bash"
      echo "$root/shell/gcpctx.bash"
      ;;
    --ps1|--pwsh|ps1|pwsh|powershell)
      [[ -f "$root/shell/gcpctx.ps1" ]] || die "shell hook not found at $root/shell/gcpctx.ps1"
      echo "$root/shell/gcpctx.ps1"
      ;;
    *)
      die "usage: gcpctx shell-path [--zsh|--bash|--ps1]"
      ;;
  esac
}

_gcpctx_append_block() {
  # _gcpctx_append_block <file> <marker_start> <marker_end> <line_to_source>
  local file="$1" start="$2" end="$3" line="$4"
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  touch "$file"
  if grep -qF "$start" "$file" 2>/dev/null; then
    info "already contains gcpctx block ($file)"
    return 0
  fi
  {
    echo ""
    echo "$start"
    echo "$line"
    echo "$end"
  } >> "$file"
  info "appended gcpctx block to $file"
}

cmd_shell_setup() {
  local zshrc="" bashrc="" pwsh_profile="" do_zsh=false do_bash=false do_pwsh=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --zshrc) zshrc="$2"; do_zsh=true; shift 2 ;;
      --bashrc) bashrc="$2"; do_bash=true; shift 2 ;;
      --pwsh-profile) pwsh_profile="$2"; do_pwsh=true; shift 2 ;;
      --zsh) do_zsh=true; shift ;;
      --bash) do_bash=true; shift ;;
      --pwsh|--powershell) do_pwsh=true; shift ;;
      --all) do_zsh=true; do_bash=true; do_pwsh=true; shift ;;
      *) die "usage: gcpctx shell-setup [--zshrc PATH] [--bashrc PATH] [--pwsh-profile PATH] [--zsh|--bash|--pwsh|--all]" ;;
    esac
  done

  # Auto-detect when no shell flags given
  if ! $do_zsh && ! $do_bash && ! $do_pwsh; then
    local shell_name
    shell_name="$(basename "${SHELL:-}")"
    case "$shell_name" in
      zsh) do_zsh=true ;;
      bash) do_bash=true ;;
      *) do_zsh=true; do_bash=true ;;
    esac
    # Windows / PowerShell available
    if command -v pwsh >/dev/null 2>&1 || command -v powershell >/dev/null 2>&1 || command -v powershell.exe >/dev/null 2>&1; then
      do_pwsh=true
    fi
    case "$(uname -s 2>/dev/null)" in
      MINGW*|MSYS*|CYGWIN*) do_bash=true; do_pwsh=true ;;
    esac
  fi

  [[ -n "$zshrc" ]] || zshrc="${ZSHRC:-$HOME/.zshrc}"
  [[ -n "$bashrc" ]] || bashrc="${BASHRC:-$HOME/.bashrc}"
  if [[ -z "$pwsh_profile" ]]; then
    if command -v pwsh >/dev/null 2>&1; then
      pwsh_profile="$(pwsh -NoProfile -Command 'echo $PROFILE' 2>/dev/null | tr -d '\r' || true)"
    elif command -v powershell >/dev/null 2>&1; then
      pwsh_profile="$(powershell -NoProfile -Command 'echo $PROFILE' 2>/dev/null | tr -d '\r' || true)"
    elif command -v powershell.exe >/dev/null 2>&1; then
      pwsh_profile="$(powershell.exe -NoProfile -Command 'echo $PROFILE' 2>/dev/null | tr -d '\r' || true)"
    else
      pwsh_profile=""
    fi
  fi

  local root hook
  root="$(package_root)"

  if $do_zsh; then
    hook="$root/shell/gcpctx.zsh"
    [[ -f "$hook" ]] || die "missing $hook"
    _gcpctx_append_block "$zshrc" "# >>> gcpctx >>>" "# <<< gcpctx <<<" "source \"$hook\""
    info "zsh hook: $hook"
  fi

  if $do_bash; then
    hook="$root/shell/gcpctx.bash"
    [[ -f "$hook" ]] || die "missing $hook"
    _gcpctx_append_block "$bashrc" "# >>> gcpctx bash >>>" "# <<< gcpctx bash <<<" "source \"$hook\""
    info "bash hook: $hook"
  fi

  if $do_pwsh; then
    hook="$root/shell/gcpctx.ps1"
    [[ -f "$hook" ]] || die "missing $hook"
    if [[ -z "$pwsh_profile" ]]; then
      info "warn: PowerShell not found; skip pwsh profile (pass --pwsh-profile PATH)"
    else
      # PowerShell dot-source line
      local ps_line=". \"$hook\""
      # On Windows paths from pwsh may use backslashes — keep as returned
      _gcpctx_append_block "$pwsh_profile" "# >>> gcpctx pwsh >>>" "# <<< gcpctx pwsh <<<" "$ps_line"
      info "pwsh hook: $hook"
      info "pwsh profile: $pwsh_profile"
    fi
  fi

  info "prompt shows (gcp:context:project) when a context is active"
  info "disable with: export GCPCTX_DISABLE_PROMPT=1"
  info "next: restart your shell, then: gcpctx bootstrap && gcpctx doctor"
}

cmd_version() {
  echo "gcpctx $(gcpctx_read_version "$(package_root)")"
}

cmd_bootstrap() {
  ensure_dirs
  gcpctx_require_trusted_gcloud
  GCPCTX_GCLOUD="$(gcpctx_gcloud_bin)"
  export GCPCTX_GCLOUD
  info "importing gcloud configurations into ~/.gcpctx"

  python3 - <<'PY'
import json, os, shutil, subprocess, pathlib

home = pathlib.Path(os.environ.get("GCPCTX_HOME", pathlib.Path.home() / ".gcpctx"))
contexts = home / "contexts"
home.mkdir(mode=0o700, parents=True, exist_ok=True)
contexts.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(home, 0o700)
os.chmod(contexts, 0o700)
(tmp := home / "tmp").mkdir(mode=0o700, parents=True, exist_ok=True)
os.chmod(tmp, 0o700)

gcloud_bin = os.environ.get("GCPCTX_GCLOUD") or "gcloud"
raw = subprocess.check_output(
    [gcloud_bin, "config", "configurations", "list", "--format=json"],
    text=True,
)
configs = json.loads(raw)

adc_path = pathlib.Path(
    os.environ.get("CLOUDSDK_CONFIG", pathlib.Path.home() / ".config" / "gcloud")
) / "application_default_credentials.json"
adc = None
if adc_path.is_file():
    with open(adc_path) as f:
        adc = json.load(f)

matched = None
for cfg in configs:
    name = cfg.get("name") or ""
    props = cfg.get("properties") or {}
    core = props.get("core") or {}
    compute = props.get("compute") or {}
    account = core.get("account") or ""
    project = core.get("project") or ""
    region = compute.get("region") or "me-west1"
    zone = compute.get("zone") or "me-west1-c"
    if not name or not project:
        print(f"gcpctx: skip '{name}' (missing project)", flush=True)
        continue
    d = contexts / name
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    meta = {
        "name": name,
        "account": account,
        "project": project,
        "quota_project": project,
        "region": region,
        "zone": zone,
        "gcloud_config": name,
    }
    with open(d / "meta.json", "w") as f:
        json.dump(meta, f, indent=2)
        f.write("\n")
    print(f"gcpctx: imported context '{name}' ({account} / {project})", flush=True)

    if adc and (
        adc.get("quota_project_id") == project
        or (adc.get("account") and adc.get("account") == account)
    ):
        creds = d / "credentials.json"
        if not creds.exists():
            shutil.copy2(adc_path, creds)
            os.chmod(creds, 0o600)
            with open(creds) as f:
                data = json.load(f)
            data["quota_project_id"] = project
            if account:
                data["account"] = account
            with open(creds, "w") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            os.chmod(creds, 0o600)
            print(f"gcpctx: copied current ADC → context '{name}'", flush=True)
            matched = name

if matched is None and adc:
    print("gcpctx: current ADC not matched to a context; run gcpctx login <name>", flush=True)
if adc_path.is_file():
    os.chmod(adc_path, 0o600)
PY

  info "done. For contexts still missing credentials: gcpctx login <name>"
  cmd_list
}

cmd_sync_adc() {
  local name="${1:-$(read_active_name)}"
  [[ -n "$name" ]] || die "specify context"
  require_context "$name"
  sync_well_known_adc "$name"
  info "synced $name credentials → $GCLOUD_ADC"
}

cmd_which() {
  echo "$GCPCTX_HOME"
  local name
  name="$(read_active_name)"
  if [[ -n "$name" ]]; then
    context_dir "$name"
    context_creds "$name"
  fi
  if marker="$(find_marker 2>/dev/null)"; then
    echo "marker: $marker"
  fi
  if gcpctx_try_resolve_gcloud; then
    echo "gcloud: $(gcpctx_gcloud_bin)"
  fi
}

main() {
  local cmd="${1:-help}"
  shift || true

  local -a args=()
  local a
  want_export=false
  for a in "$@"; do
    if [[ "$a" == "--export" ]]; then
      want_export=true
    else
      args+=("$a")
    fi
  done

  # Commands that must not recurse into history recording
  local skip_history=false
  case "$cmd" in
    help|--help|-h|version|--version|-V|completion|history|timeline|snapshots|which) skip_history=true ;;
  esac

  local exit_code=0
  set +e
  case "$cmd" in
    init) cmd_init ${args[@]+"${args[@]}"} ;;
    login) cmd_login ${args[@]+"${args[@]}"} ;;
    use) cmd_use ${args[@]+"${args[@]}"} ;;
    project) cmd_project ${args[@]+"${args[@]}"} ;;
    scan) cmd_scan ${args[@]+"${args[@]}"} ;;
    projects) cmd_projects ${args[@]+"${args[@]}"} ;;
    activate) cmd_activate ${args[@]+"${args[@]}"} ;;
    deactivate) cmd_deactivate ${args[@]+"${args[@]}"} ;;
    list|ls) cmd_list ${args[@]+"${args[@]}"} ;;
    current|status) cmd_current ${args[@]+"${args[@]}"} ;;
    env) cmd_env ${args[@]+"${args[@]}"} ;;
    exec) cmd_exec ${args[@]+"${args[@]}"} ;;
    history) cmd_history ${args[@]+"${args[@]}"} ;;
    timeline) cmd_timeline ${args[@]+"${args[@]}"} ;;
    snapshots) cmd_snapshots ${args[@]+"${args[@]}"} ;;
    replay) cmd_replay ${args[@]+"${args[@]}"} ;;
    undo) cmd_undo ${args[@]+"${args[@]}"} ;;
    protect) cmd_protect ${args[@]+"${args[@]}"} ;;
    unprotect) cmd_unprotect ${args[@]+"${args[@]}"} ;;
    assert) cmd_assert ${args[@]+"${args[@]}"} ;;
    completion) cmd_completion ${args[@]+"${args[@]}"} ;;
    doctor) cmd_doctor ${args[@]+"${args[@]}"} ;;
    secrets) cmd_secrets ${args[@]+"${args[@]}"} ;;
    bootstrap) cmd_bootstrap ${args[@]+"${args[@]}"} ;;
    sync-adc) cmd_sync_adc ${args[@]+"${args[@]}"} ;;
    shell-setup) cmd_shell_setup ${args[@]+"${args[@]}"} ;;
    shell-path) cmd_shell_path ${args[@]+"${args[@]}"} ;;
    which) cmd_which ${args[@]+"${args[@]}"} ;;
    version|--version|-V) cmd_version ;;
    help|--help|-h) usage ;;
    *) die "unknown command '$cmd' (try: gcpctx help)" ;;
  esac
  exit_code=$?
  set -e

  # Journal non-exec mutating/read commands (exec journals itself).
  # Skip when --export so stdout stays eval-safe.
  if ! $skip_history && ! $want_export && [[ "$cmd" != "exec" && "$cmd" != "replay" && "$cmd" != "undo" ]]; then
    if gcpctx_history_enabled 2>/dev/null; then
      gcpctx_history_record_simple "$cmd" "$exit_code" ${args[@]+"${args[@]}"} >/dev/null 2>&1 || true
    fi
  fi

  return "$exit_code"
}

main "$@"
